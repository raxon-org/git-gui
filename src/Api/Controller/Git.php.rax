class Git extends Controller {
    const DIR = __DIR__ . DIRECTORY_SEPARATOR;
    const NAME = 'Git';

    public static function scan(App $object){
        try {
            $role = Permission::controller(
                $object,
                Git::NAME,
                __FUNCTION__,
                $user
            );
            if($role){
               $dir_list = [];
               $dir_list[] = $object->config('project.dir.root');
               ddd($object->config('project.dir');
            }
        } catch (Exception | FileWriteException | ObjectException | LocateException | UrlEmptyException | UrlNotExistException $exception){
            return $exception;
        }
    }


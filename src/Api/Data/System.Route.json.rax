{
    "System": {
      "Route": [
        {
          "#class": "System.Route",
          "name": "git-gui-scan",
          "host": "{{options('backend.host')}}",
          "controller": "Domain:{{app.controller.host(options('backend.host'))}}:Controller:Git:Gui:scan",
          "path": "/Git/Gui/Scan/",
          "priority": 2001,
          "method": [
            "POST"
          ]
        }
      ]
    }
}
{{$backend.host = options('backend.host')}}
{{$frontend.host = options('frontend.host')}}{{literal}}
//{{RAX}}
import { input } from "/Application/Git/Gui/Module/Input.js";
import { directory } from "/Application/Git/Gui/Module/Directory.js";
import { file } from "/Application/Git/Gui/Module/File.js";
import { head } from "/Application/Git/Gui/Module/Head.js";
import { menu } from "/Application/Git/Gui/Module/Menu.js";
import { root } from "/Module/Web.js";
import { taskbar } from "/Application/Desktop/Module/Taskbar.js";
import { task } from "/Application/Desktop/Module/Task.js";
import { dialog } from "/Dialog/Module/Dialog.js";
import { language, translation } from "/Module/Translation.js";
import { version } from "/Module/Priya.js";
import user from "/Module/User.js";
require(
[
root() + 'Application/Git/Gui/Css/Indent.css?' + version(),
root() + 'Application/Git/Gui/Css/Git.css?' + version(),
root() + 'Dialog/Css/Dialog.css?' + version(),
root() + 'Js/Dropzone/5.9.2/min/dropzone.min.css?' + version(),
root() + 'Js/Dropzone/5.9.2/min/dropzone.min.js?' + version(),
root() + 'Js/Showdown/2.1.0/showdown.min.js?' + version(),
root() + 'Highlight/styles/default.min.css?' + version()
],
function(){
user.init({
    "backend": {
        "url": {
            "current": "{{server.url(\"{{/literal}}{{$backend.host}}{{literal}}\")}}User/Current/",
            "refresh": "{{server.url(\"{{/literal}}{{$backend.host}}{{literal}}\")}}User/Refresh/Token/",
        }
    },
    "frontend": {
        "url": {
            "login": "{{server.url(\"{{/literal}}{{$frontend.host}}{{literal}}\")}}User/Login/",
        }
    }
});
language("{{language()}}");
translation.import("{{raw|>translation.export('json-line')}}");
file.data.set({
    "route.backend.generate": "{{server.url(\"{{/literal}}{{$backend.host}}{{literal}}\")}}Git/Generate/",
    "route.backend.tool": "{{server.url(\"{{/literal}}{{$backend.host}}{{literal}}\")}}Git/Tool/",
    "route.backend.abort": "{{server.url(\"{{/literal}}{{$backend.host}}{{literal}}\")}}Git/Abort/",
    "route.backend.sse": "{{server.url(\"{{/literal}}{{$backend.host}}{{literal}}\")}}Git/Sse/?user.key=" + user.get('key'),
    "route.backend.queue": "{{server.url(\"{{/literal}}{{$backend.host}}{{literal}}\")}}Git/Queue/",
    "route.backend.upload": "{{server.url(\"{{/literal}}{{$backend.host}}{{literal}}\")}}FileSystem/Upload/",
    "route.backend.target": "{{config('project.dir.audio')}}Recorder/{{date('W-Y')}}/",
    "route.backend.speech.to.text": "{{server.url(\"{{/literal}}{{$backend.host}}{{literal}}\")}}Audio/Speech/To/Text/",
});
taskbar.add("{{$section.name}}", "{{$id}}");
input.init("{{$id}}");
menu.init("{{$id}}");
head.init("{{$id}}");
dialog.init("{{$id}}");
taskbar.active("{{$id}}");
task.active({
    "id": "{{$id}}",
    "namespace": "{{$section.name}}"
});
});
{{/literal}}